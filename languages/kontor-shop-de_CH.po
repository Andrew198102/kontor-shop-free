msgstr "IBAN prüfen (Länge/Prüfsumme)"

#: src/Admin/Settings/PaymentSection.php:197
msgid "Validate BIC"
msgstr "BIC prüfen"

#: src/Admin/Settings/PaymentSection.php:203
