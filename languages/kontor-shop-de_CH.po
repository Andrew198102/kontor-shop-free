#: src/Pro__premium_only/Packing/PackingModule.php:124
msgid "<p>Hi {{warehouse_manager_name}},</p><p>payment for order <strong>{{order_number}}</strong> is confirmed. Please prepare it for shipping/pickup:</p><h3>Products</h3><p>{{items}}</p><p>{{delivery_info}}</p><p><strong>Pack now (also on your phone):</strong> {{pack_url}}</p><p>{{shop_name}}</p>"
