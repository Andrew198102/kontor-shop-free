msgstr "Höchstens so viele auf einem breiten Bildschirm. Schmalere Bildschirme zeigen weniger; am Handy steht immer ein Artikel pro Zeile."

#: src/Admin/Settings/DesignSection.php:246
#: src/Admin/Settings/DesignSection.php:251
#: src/Pro__premium_only/ShopTypes/ShopTypesPage.php:338
msgid "Image format"
msgstr "Bildformat"

#: src/Admin/Settings/DesignSection.php:248
#: src/Pro__premium_only/ShopTypes/ShopTypesPage.php:338
